{
  "name": "@opentimbre/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/renatosantos0611/OpenTimbre.git"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:prompts",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=esm --target=node22 --external:electron --external:electron-updater --external:@julusian/midi --outfile=dist/main/main.js",
    "build:preload": "esbuild src/preload/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build:renderer": "ng build desktop",
    "build:prompts": "node scripts/copy-prompts.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:main && npm run test:renderer",
    "test:main": "node --test \"src/main/**/*.test.ts\"",
    "test:renderer": "ng run desktop:unit-test",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test -c playwright.packaged.config.ts",
    "lint": "eslint src",
    "start": "electron ."
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@opentimbre/contracts": "*",
    "@opentimbre/core": "*",
    "@opentimbre/platform-node": "*",
    "electron-updater": "^6.8.9",
    "openai": "^7.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@lucide/angular": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.opentimbre.desktop",
    "productName": "OpenTimbre",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "renatosantos0611",
      "repo": "OpenTimbre"
    }
  }
}
