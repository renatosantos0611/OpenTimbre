{
  "name": "@opentimbre/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "ng build desktop",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json --noEmit",
    "test:main": "node --test \"src/main/**/*.test.ts\"",
    "test:renderer": "ng run desktop:unit-test",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "start": "electron ."
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@opentimbre/contracts": "*",
    "@opentimbre/core": "*",
    "@opentimbre/platform-node": "*",
    "electron": "^43.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@lucide/angular": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.10"
  }
}
