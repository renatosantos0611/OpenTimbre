{
  "name": "@opentimbre/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && ng build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json --noEmit",
    "test:main": "node --test \"src/main/**/*.test.ts\"",
    "lint": "eslint src",
    "start": "electron ."
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@opentimbre/contracts": "*",
    "electron": "^43.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0"
  }
}
